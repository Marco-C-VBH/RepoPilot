# Copy to `.env` (git-ignored) and fill in the keys you have.  CLI entry points
# load this file; library code only ever reads the environment, never logs a
# key, and the sandbox containers cannot see host variables at all.
#
# Make a dedicated key per provider named "repopilot" and set a monthly spend
# limit in the provider console; revoke and re-issue it if it ever leaks.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: which model plays which role (defaults in repopilot/models/config.py).
# Any model used must have a price in repopilot/models/pricing.py.
# REPOPILOT_STRONG_MODEL=claude-sonnet-5
# REPOPILOT_CHEAP_MODEL=claude-haiku-4-5-20251001
# REPOPILOT_STRONG_MODEL=gpt-5.6-terra
# REPOPILOT_CHEAP_MODEL=gpt-5.6-luna
