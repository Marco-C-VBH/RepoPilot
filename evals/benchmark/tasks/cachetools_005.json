  "source": "mutation",
  "description": "Applying `@cached(...)` with a newly created cache has no effect.\n\n```python\ncache = LRUCache(maxsize=8)\n\n@cached(cache)\ndef square(n):\n    print(\"computing\", n)\n    return n * n\n\nsquare(3)\nsquare(3)  # prints \"computing 3\" a second time; len(cache) is still 0\n```\n\nThe wrapped function runs on every call and nothing is ever stored, although `square.cache` is the cache object that was passed in. A plain `dict` used as the cache shows the same behaviour. Repeated calls with the same arguments should be served from the cache.",
  "bug_patch": "diff --git a/src/cachetools/_cached.py b/src/cachetools/_cached.py\nindex 5b09d5a..81c7510 100644\n--- a/src/cachetools/_cached.py\n+++ b/src/cachetools/_cached.py\n@@ -239,7 +239,7 @@ def _wrapper(func, cache, key, lock=None, cond=None, info=None):\n         else:\n             wrapper = _unlocked_info(func, cache, key, info)\n     else:\n-        if cache is None:\n+        if not cache:\n             wrapper = _uncached(func)\n         elif cond is not None and lock is not None:\n             wrapper = _condition(func, cache, key, lock, cond)\n",
  "gold_patch": "diff --git a/src/cachetools/_cached.py b/src/cachetools/_cached.py\nindex 81c7510..5b09d5a 100644\n--- a/src/cachetools/_cached.py\n+++ b/src/cachetools/_cached.py\n@@ -239,7 +239,7 @@ def _wrapper(func, cache, key, lock=None, cond=None, info=None):\n         else:\n             wrapper = _unlocked_info(func, cache, key, info)\n     else:\n-        if not cache:\n+        if cache is None:\n             wrapper = _uncached(func)\n         elif cond is not None and lock is not None:\n             wrapper = _condition(func, cache, key, lock, cond)\n",
  "hidden_test_patch": "diff --git a/tests/test_repopilot_cachetools_005.py b/tests/test_repopilot_cachetools_005.py\nnew file mode 100644\nindex 0000000..5a902e7\n--- /dev/null\n+++ b/tests/test_repopilot_cachetools_005.py\n@@ -0,0 +1,30 @@\n+from cachetools import LRUCache, cached\n+\n+\n+def test_decorated_function_is_cached_after_the_first_call():\n+    calls = []\n+    cache = LRUCache(maxsize=8)\n+\n+    @cached(cache)\n+    def square(n):\n+        calls.append(n)\n+        return n * n\n+\n+    assert square(3) == 9\n+    assert square(3) == 9\n+    assert calls == [3]\n+    assert len(cache) == 1\n+\n+\n+def test_plain_dict_works_as_the_cache():\n+    calls = []\n+    memo = {}\n+\n+    @cached(memo)\n+    def double(n):\n+        calls.append(n)\n+        return 2 * n\n+\n+    assert [double(2), double(2), double(5)] == [4, 4, 10]\n+    assert calls == [2, 5]\n+    assert len(memo) == 2\n",
