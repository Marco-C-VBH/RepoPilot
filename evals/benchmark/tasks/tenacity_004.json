  "base_commit": "a2af454834c6bb5a1e39d67334031cdaf0f475b5",
  "source": "mutation",
  "description": "With `reraise=True`, a retry requested from inside an `except` block loses the original error.\n\n```python\n@retry(stop=stop_after_attempt(2), wait=wait_none(), reraise=True)\ndef call_upstream():\n    try:\n        upstream()  # raises UpstreamError(\"503 from upstream\")\n    except UpstreamError:\n        raise TryAgain\n```\n\nAfter the last attempt the caller receives `tenacity.TryAgain` rather than the `UpstreamError` that triggered the retry, so the real failure and its message are gone. Rewriting the handler as `raise TryAgain from err` avoids the problem, but a plain `raise TryAgain` inside the `except` block used to surface `UpstreamError` as well, and should again.",
  "bug_patch": "diff --git a/tenacity/__init__.py b/tenacity/__init__.py\nindex 21d7f50..ddb6f64 100644\n--- a/tenacity/__init__.py\n+++ b/tenacity/__init__.py\n@@ -190,7 +190,7 @@ class RetryError(Exception):\n             # an \"except\" block), surface the underlying exception that caused\n             # the retry rather than the opaque TryAgain sentinel.\n             if isinstance(exc, TryAgain):\n-                cause = exc.__cause__ or exc.__context__\n+                cause = exc.__cause__\n                 if cause is not None:\n                     raise cause.with_traceback(cause.__traceback__) from None\n             raise self.last_attempt.result()\n",
  "gold_patch": "diff --git a/tenacity/__init__.py b/tenacity/__init__.py\nindex ddb6f64..21d7f50 100644\n--- a/tenacity/__init__.py\n+++ b/tenacity/__init__.py\n@@ -190,7 +190,7 @@ class RetryError(Exception):\n             # an \"except\" block), surface the underlying exception that caused\n             # the retry rather than the opaque TryAgain sentinel.\n             if isinstance(exc, TryAgain):\n-                cause = exc.__cause__\n+                cause = exc.__cause__ or exc.__context__\n                 if cause is not None:\n                     raise cause.with_traceback(cause.__traceback__) from None\n             raise self.last_attempt.result()\n",
  "hidden_test_patch": "diff --git a/tests/test_repopilot_tenacity_004.py b/tests/test_repopilot_tenacity_004.py\nnew file mode 100644\nindex 0000000..d8b4e48\n--- /dev/null\n+++ b/tests/test_repopilot_tenacity_004.py\n@@ -0,0 +1,39 @@\n+import pytest\n+import tenacity\n+\n+\n+class UpstreamError(Exception):\n+    pass\n+\n+\n+def upstream():\n+    raise UpstreamError(\"503 from upstream\")\n+\n+\n+def test_try_again_raised_inside_except_surfaces_the_handled_error():\n+    @tenacity.retry(stop=tenacity.stop_after_attempt(2), wait=tenacity.wait_none(), reraise=True)\n+    def call_upstream():\n+        try:\n+            upstream()\n+        except UpstreamError:\n+            raise tenacity.TryAgain  # noqa: B904\n+\n+    with pytest.raises(UpstreamError) as info:\n+        call_upstream()\n+    assert str(info.value) == \"503 from upstream\"\n+\n+\n+def test_try_again_after_handling_work_still_surfaces_the_handled_error():\n+    seen = []\n+\n+    @tenacity.retry(stop=tenacity.stop_after_attempt(3), wait=tenacity.wait_none(), reraise=True)\n+    def call_upstream():\n+        try:\n+            upstream()\n+        except UpstreamError as err:\n+            seen.append(str(err))\n+            raise tenacity.TryAgain  # noqa: B904\n+\n+    with pytest.raises(UpstreamError):\n+        call_upstream()\n+    assert seen == [\"503 from upstream\"] * 3\n",
  "fail_to_pass": [
