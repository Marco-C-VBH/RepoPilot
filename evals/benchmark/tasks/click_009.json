  "base_commit": "9ce34f20d2370f2e298268227edf0ffce6b9725f",
  "source": "real",
  "description": "A flag option declared with an explicit `type` never turns on: passing the flag leaves the parameter at its default.\n\n```python\nimport click\n\n@click.command()\n@click.option(\"--verbose\", is_flag=True, type=bool)\ndef cli(verbose):\n    print(repr(verbose))\n```\n\n```\n$ cli --verbose\nFalse\n$ cli\nFalse\n```\n\nWithout the `type=bool` the same declaration prints `True` for `cli --verbose` and `False` for `cli`. The explicit type is redundant here, but it is documented as accepted and used to behave the same; it also makes a difference for a flag whose value should be converted, and `type=click.BOOL` behaves the same way as `type=bool`. With `default=True` and `type=bool`, `cli --verbose` prints `True` instead of `False`, so the flag cannot negate its default either, and with `type=str` passing the flag gives `None` where `True` is expected. Expected: with an explicit `type`, `--verbose` still sets the parameter to the flag's value (the opposite of the default, `True` by default), and the value is then converted by the type as usual.",
  "bug_patch": null,
  "gold_patch": "diff --git a/src/click/core.py b/src/click/core.py\nindex 4745b533..f57ada62 100644\n--- a/src/click/core.py\n+++ b/src/click/core.py\n@@ -2610,10 +2610,11 @@ class Option(Parameter):\n             else:\n                 self.default = False\n \n+        if is_flag and flag_value is None:\n+            flag_value = not self.default\n+\n         self.type: types.ParamType\n         if is_flag and type is None:\n-            if flag_value is None:\n-                flag_value = not self.default\n             # Re-guess the type from the flag value instead of the\n             # default.\n             self.type = types.convert_type(None, flag_value)\n",
  "hidden_test_patch": "diff --git a/tests/test_repopilot_click_009.py b/tests/test_repopilot_click_009.py\nnew file mode 100644\nindex 0000000..d3561ab\n--- /dev/null\n+++ b/tests/test_repopilot_click_009.py\n@@ -0,0 +1,42 @@\n+import pytest\n+\n+import click\n+\n+\n+@pytest.mark.parametrize(\n+    (\"opts\", \"pass_flag\", \"expected\"),\n+    [\n+        pytest.param({\"type\": bool}, False, \"False\"),\n+        pytest.param({\"type\": bool}, True, \"True\"),\n+        pytest.param({\"type\": bool, \"default\": True}, False, \"True\"),\n+        pytest.param({\"type\": bool, \"default\": True}, True, \"False\"),\n+        pytest.param({\"type\": click.BOOL}, False, \"False\"),\n+        pytest.param({\"type\": click.BOOL}, True, \"True\"),\n+        pytest.param({\"type\": click.BOOL, \"default\": True}, False, \"True\"),\n+        pytest.param({\"type\": click.BOOL, \"default\": True}, True, \"False\"),\n+        pytest.param({\"type\": str}, False, \"\"),\n+        pytest.param({\"type\": str}, True, \"True\"),\n+    ],\n+)\n+def test_flag_value_is_correctly_set(runner, opts, pass_flag, expected):\n+    @click.command()\n+    @click.option(\"--foo\", is_flag=True, **opts)\n+    def cmd(foo):\n+        click.echo(foo)\n+\n+    result = runner.invoke(cmd, [\"--foo\"] if pass_flag else [])\n+    assert result.output == f\"{expected}\\n\"\n+\n+\n+def test_non_flag_with_non_negatable_default(runner):\n+    class NonNegatable:\n+        def __bool__(self):\n+            raise ValueError(\"Cannot negate this object\")\n+\n+    @click.command()\n+    @click.option(\"--foo\", default=NonNegatable())\n+    def cmd(foo):\n+        pass\n+\n+    result = runner.invoke(cmd)\n+    assert result.exit_code == 0\n",
  "fail_to_pass": [
