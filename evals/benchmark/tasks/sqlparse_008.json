{
  "id": "sqlparse_008",
  "repo": "https://github.com/andialbrecht/sqlparse",
  "base_commit": "ec0af5bf6345750d84274bc5c857d4a75b88619b",
  "source": "mutation",
  "description": "Reindenting a `CASE` expression glues the `ELSE` branch onto the last `WHEN` line.\n\n```python\nimport sqlparse\n\nsql = \"select case when a then 1 when b then 2 else 3 end from t\"\nprint(sqlparse.format(sql, reindent=True))\n```\n\n```\nselect case\n           when a then 1\n           when b then 2 else 3\n       end\nfrom t\n```\n\nExpected `else 3` on its own line under the `when` lines, which is how it used to come out:\n\n```\nselect case\n           when a then 1\n           when b then 2\n           else 3\n       end\nfrom t\n```\n\n`reindent_aligned=True` shows the same thing (`when b then 2 else 3` on one line instead of `else 3` aligned under the `when` lines), and a `CASE` with a single `WHEN` followed by `ELSE` (`case when a then 1 else 3 end as x`) is affected too. A `CASE` without an `ELSE` is formatted exactly as before, so only the `ELSE` branch lost its line.",
  "bug_patch": "diff --git a/sqlparse/sql.py b/sqlparse/sql.py\nindex be74694..95bddd3 100644\n--- a/sqlparse/sql.py\n+++ b/sqlparse/sql.py\n@@ -598,7 +598,6 @@ class Case(TokenList):\n                 mode = VALUE\n \n             elif token.match(T.Keyword, 'ELSE'):\n-                ret.append((None, []))\n                 mode = VALUE\n \n             elif token.match(T.Keyword, 'END'):\n",
  "gold_patch": "diff --git a/sqlparse/sql.py b/sqlparse/sql.py\nindex 95bddd3..be74694 100644\n--- a/sqlparse/sql.py\n+++ b/sqlparse/sql.py\n@@ -598,6 +598,7 @@ class Case(TokenList):\n                 mode = VALUE\n \n             elif token.match(T.Keyword, 'ELSE'):\n+                ret.append((None, []))\n                 mode = VALUE\n \n             elif token.match(T.Keyword, 'END'):\n",
  "hidden_test_patch": "diff --git a/tests/test_repopilot_sqlparse_008.py b/tests/test_repopilot_sqlparse_008.py\nnew file mode 100644\nindex 0000000..9918499\n--- /dev/null\n+++ b/tests/test_repopilot_sqlparse_008.py\n@@ -0,0 +1,50 @@\n+import sqlparse\n+\n+\n+def test_reindent_puts_else_on_its_own_line():\n+    formatted = sqlparse.format(\n+        \"select case when a then 1 when b then 2 else 3 end from t\", reindent=True\n+    )\n+    assert formatted == \"\\n\".join(\n+        [\n+            \"select case\",\n+            \"           when a then 1\",\n+            \"           when b then 2\",\n+            \"           else 3\",\n+            \"       end\",\n+            \"from t\",\n+        ]\n+    )\n+\n+\n+def test_reindent_puts_else_on_its_own_line_with_a_single_when():\n+    formatted = sqlparse.format(\"select case when a then 1 else 3 end as x from t\", reindent=True)\n+    assert formatted == \"\\n\".join(\n+        [\n+            \"select case\",\n+            \"           when a then 1\",\n+            \"           else 3\",\n+            \"       end as x\",\n+            \"from t\",\n+        ]\n+    )\n+    # a CASE without ELSE keeps its layout\n+    formatted = sqlparse.format(\"select case when a then 1 when b then 2 end from t\", reindent=True)\n+    assert formatted == \"\\n\".join(\n+        [\"select case\", \"           when a then 1\", \"           when b then 2\", \"       end\", \"from t\"]\n+    )\n+\n+\n+def test_aligned_reindent_puts_else_on_its_own_line():\n+    formatted = sqlparse.format(\n+        \"select case when a then 1 when b then 2 else 3 end from t\", reindent_aligned=True\n+    )\n+    assert formatted == \"\\n\".join(\n+        [\n+            \"select case when a then 1\",\n+            \"            when b then 2\",\n+            \"            else 3\",\n+            \"             end\",\n+            \"  from t\",\n+        ]\n+    )\n",
  "fail_to_pass": [
