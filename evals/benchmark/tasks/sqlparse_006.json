  "source": "mutation",
  "description": "`wrap_after` wraps one column too early: a select list that fits the limit exactly is broken before its last item.\n\n```python\nimport sqlparse\n\nprint(sqlparse.format(\"select aaaa, bbbb, cccc, dddd from t\", reindent=True, wrap_after=17))\n```\n\n```\nselect aaaa, bbbb,\n       cccc, dddd\nfrom t\n```\n\nExpected `select aaaa, bbbb, cccc,` on the first line (that line is 24 characters, but the width counts from the first column, and `aaaa, bbbb, cccc,` is 17 — exactly the limit, which used to be allowed) with only `dddd` wrapped. The same off-by-one shows with `wrap_after=10` on `select a, bb, ccc, dddd from t`: `a, bb,` (6) fits, `a, bb, ccc,` (11) does not, so the expected first line is `select a, bb,` — instead the break comes after `a,`, as if the limit were 9. Function arguments are affected in the same way: `select foo(aaaa, bbbb, cccc, dddd) from t` with `wrap_after=22` used to keep `bbbb, cccc, dddd)` on the second line and now wraps `dddd)` onto a third, and with `wrap_after=17` the break moves from after `cccc,` to after `bbbb,`. Lists that are clearly over or clearly under the limit wrap as before; only inputs that land exactly on the limit changed.",
  "bug_patch": "diff --git a/sqlparse/filters/reindent.py b/sqlparse/filters/reindent.py\nindex 7dc2b82..20d1db9 100644\n--- a/sqlparse/filters/reindent.py\n+++ b/sqlparse/filters/reindent.py\n@@ -141,7 +141,7 @@ class ReindentFilter:\n                 for token in identifiers:\n                     # Add 1 for the \",\" separator\n                     position += len(token.value) + 1\n-                    if position > (self.wrap_after - self.offset):\n+                    if position >= (self.wrap_after - self.offset):\n                         adjust = 0\n                         if self.comma_first:\n                             adjust = -2\n@@ -183,7 +183,7 @@ class ReindentFilter:\n                     # Add 1 for the \",\" separator\n                     position += len(token.value) + 1\n                     if (self.wrap_after > 0\n-                            and position > (self.wrap_after - self.offset)):\n+                            and position >= (self.wrap_after - self.offset)):\n                         adjust = 0\n                         tlist.insert_before(token, self.nl(offset=adjust))\n                         position = 0\n",
  "gold_patch": "diff --git a/sqlparse/filters/reindent.py b/sqlparse/filters/reindent.py\nindex 20d1db9..7dc2b82 100644\n--- a/sqlparse/filters/reindent.py\n+++ b/sqlparse/filters/reindent.py\n@@ -141,7 +141,7 @@ class ReindentFilter:\n                 for token in identifiers:\n                     # Add 1 for the \",\" separator\n                     position += len(token.value) + 1\n-                    if position >= (self.wrap_after - self.offset):\n+                    if position > (self.wrap_after - self.offset):\n                         adjust = 0\n                         if self.comma_first:\n                             adjust = -2\n@@ -183,7 +183,7 @@ class ReindentFilter:\n                     # Add 1 for the \",\" separator\n                     position += len(token.value) + 1\n                     if (self.wrap_after > 0\n-                            and position >= (self.wrap_after - self.offset)):\n+                            and position > (self.wrap_after - self.offset)):\n                         adjust = 0\n                         tlist.insert_before(token, self.nl(offset=adjust))\n                         position = 0\n",
  "hidden_test_patch": "diff --git a/tests/test_repopilot_sqlparse_006.py b/tests/test_repopilot_sqlparse_006.py\nnew file mode 100644\nindex 0000000..b33c453\n--- /dev/null\n+++ b/tests/test_repopilot_sqlparse_006.py\n@@ -0,0 +1,35 @@\n+import sqlparse\n+\n+\n+def test_wrap_after_keeps_a_line_that_exactly_fits():\n+    formatted = sqlparse.format(\n+        \"select aaaa, bbbb, cccc, dddd from t\", reindent=True, wrap_after=17\n+    )\n+    assert formatted == \"select aaaa, bbbb, cccc,\\n       dddd\\nfrom t\"\n+\n+\n+def test_wrap_after_boundary_in_the_select_list():\n+    sql = \"select a, bb, ccc, dddd from t\"\n+    assert sqlparse.format(sql, reindent=True, wrap_after=10) == (\n+        \"select a, bb,\\n       ccc,\\n       dddd\\nfrom t\"\n+    )\n+    assert sqlparse.format(sql, reindent=True, wrap_after=9) == (\n+        \"select a,\\n       bb,\\n       ccc,\\n       dddd\\nfrom t\"\n+    )\n+\n+\n+def test_wrap_after_boundary_in_function_arguments():\n+    sql = \"select foo(aaaa, bbbb, cccc, dddd) from t\"\n+    assert sqlparse.format(sql, reindent=True, wrap_after=22) == (\n+        \"select foo(aaaa,\\n         bbbb, cccc, dddd)\\nfrom t\"\n+    )\n+    assert sqlparse.format(sql, reindent=True, wrap_after=17) == (\n+        \"select foo(aaaa,\\n         bbbb, cccc,\\n         dddd)\\nfrom t\"\n+    )\n+\n+\n+def test_wrap_after_boundary_in_function_arguments_with_an_alias():\n+    sql = \"select x, foo(aaaa, bbbb, cccc, dddd) as y from t\"\n+    assert sqlparse.format(sql, reindent=True, wrap_after=22) == (\n+        \"select x,\\n       foo(aaaa,\\n         bbbb, cccc, dddd) as y\\nfrom t\"\n+    )\n",
  "fail_to_pass": [
