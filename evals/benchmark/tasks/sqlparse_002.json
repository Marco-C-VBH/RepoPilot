  "base_commit": "ec0af5bf6345750d84274bc5c857d4a75b88619b",
  "source": "mutation",
  "description": "Both reindent modes now break a `BETWEEN … AND …` range across two lines: the `AND` that belongs to the range is treated like the boolean `AND` between conditions.\n\n```python\nimport sqlparse\n\nsql = \"select * from t where a between 1 and 2 and b = 3\"\nprint(sqlparse.format(sql, reindent=True))\nprint(sqlparse.format(sql, reindent_aligned=True))\n```\n\n```\nselect *\nfrom t\nwhere a between 1\n  and 2\n  and b = 3\n```\n\n```\nselect *\n  from t\n where a between 1\n   and 2\n   and b = 3\n```\n\nExpected `where a between 1 and 2` on one line followed by `and b = 3` (aligned: ` where a between 1 and 2` / `   and b = 3`), which is what these options produced before. A second range in the same condition (`and b between 3 and 4`) is split the same way, and so is a range inside a `JOIN … ON` condition with `reindent=True`. Only the `AND` directly after a `BETWEEN` range should stay on the line; the boolean `AND`/`OR` that follow must still start new lines.",
  "bug_patch": "diff --git a/sqlparse/filters/aligned_indent.py b/sqlparse/filters/aligned_indent.py\nindex dc60926..1750e9d 100644\n--- a/sqlparse/filters/aligned_indent.py\n+++ b/sqlparse/filters/aligned_indent.py\n@@ -92,8 +92,6 @@ class AlignedIndentFilter:\n         # treat \"BETWEEN x and y\" as a single statement\n         if token and token.normalized == 'BETWEEN':\n             tidx, token = self._next_token(tlist, tidx)\n-            if token and token.normalized == 'AND':\n-                tidx, token = self._next_token(tlist, tidx)\n         return tidx, token\n \n     def _split_kwds(self, tlist):\ndiff --git a/sqlparse/filters/reindent.py b/sqlparse/filters/reindent.py\nindex 7dc2b82..22acc83 100644\n--- a/sqlparse/filters/reindent.py\n+++ b/sqlparse/filters/reindent.py\n@@ -61,9 +61,6 @@ class ReindentFilter:\n         if token and token.normalized == 'BETWEEN':\n             tidx, token = self._next_token(tlist, tidx)\n \n-            if token and token.normalized == 'AND':\n-                tidx, token = self._next_token(tlist, tidx)\n-\n         return tidx, token\n \n     def _split_kwds(self, tlist):\n",
  "gold_patch": "diff --git a/sqlparse/filters/aligned_indent.py b/sqlparse/filters/aligned_indent.py\nindex 1750e9d..dc60926 100644\n--- a/sqlparse/filters/aligned_indent.py\n+++ b/sqlparse/filters/aligned_indent.py\n@@ -92,6 +92,8 @@ class AlignedIndentFilter:\n         # treat \"BETWEEN x and y\" as a single statement\n         if token and token.normalized == 'BETWEEN':\n             tidx, token = self._next_token(tlist, tidx)\n+            if token and token.normalized == 'AND':\n+                tidx, token = self._next_token(tlist, tidx)\n         return tidx, token\n \n     def _split_kwds(self, tlist):\ndiff --git a/sqlparse/filters/reindent.py b/sqlparse/filters/reindent.py\nindex 22acc83..7dc2b82 100644\n--- a/sqlparse/filters/reindent.py\n+++ b/sqlparse/filters/reindent.py\n@@ -61,6 +61,9 @@ class ReindentFilter:\n         if token and token.normalized == 'BETWEEN':\n             tidx, token = self._next_token(tlist, tidx)\n \n+            if token and token.normalized == 'AND':\n+                tidx, token = self._next_token(tlist, tidx)\n+\n         return tidx, token\n \n     def _split_kwds(self, tlist):\n",
  "hidden_test_patch": "diff --git a/tests/test_repopilot_sqlparse_002.py b/tests/test_repopilot_sqlparse_002.py\nnew file mode 100644\nindex 0000000..b93f094\n--- /dev/null\n+++ b/tests/test_repopilot_sqlparse_002.py\n@@ -0,0 +1,34 @@\n+import sqlparse\n+\n+\n+def test_reindent_keeps_between_and_together():\n+    formatted = sqlparse.format(\n+        \"select * from t where a between 1 and 2 and b = 3\", reindent=True\n+    )\n+    assert formatted == \"select *\\nfrom t\\nwhere a between 1 and 2\\n  and b = 3\"\n+\n+\n+def test_reindent_keeps_between_and_together_in_a_join_condition():\n+    formatted = sqlparse.format(\n+        \"select * from t join u on t.id = u.id and u.x between 1 and 5 or u.y = 2\",\n+        reindent=True,\n+    )\n+    assert formatted == (\n+        \"select *\\nfrom t\\njoin u on t.id = u.id\\nand u.x between 1 and 5\\nor u.y = 2\"\n+    )\n+\n+\n+def test_aligned_reindent_keeps_between_and_together():\n+    formatted = sqlparse.format(\n+        \"select * from t where a between 1 and 2 and b = 3\", reindent_aligned=True\n+    )\n+    assert formatted == \"select *\\n  from t\\n where a between 1 and 2\\n   and b = 3\"\n+\n+\n+def test_aligned_reindent_keeps_two_betweens_together():\n+    formatted = sqlparse.format(\n+        \"select * from t where a between 1 and 2 and b between 3 and 4\", reindent_aligned=True\n+    )\n+    assert formatted == (\n+        \"select *\\n  from t\\n where a between 1 and 2\\n   and b between 3 and 4\"\n+    )\n",
