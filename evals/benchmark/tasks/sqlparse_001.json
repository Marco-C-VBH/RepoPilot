{
  "id": "sqlparse_001",
  "repo": "https://github.com/andialbrecht/sqlparse",
  "base_commit": "ec0af5bf6345750d84274bc5c857d4a75b88619b",
  "source": "mutation",
  "description": "The `except` keyword is no longer treated as the start of a new clause: the first query's where-clause swallows it, and neither reindent mode puts it on its own line.\n\n```python\nimport sqlparse\n\nsql = \"select 1 from foo where 2 = 3 except select 2 from bar where 1 = 2\"\nprint(sqlparse.format(sql, reindent=True))\n```\n\n```\nselect 1\nfrom foo\nwhere 2 = 3 except\n  select 2\n  from bar where 1 = 2\n```\n\nExpected, as before:\n\n```\nselect 1\nfrom foo\nwhere 2 = 3\nexcept\nselect 2\nfrom bar\nwhere 1 = 2\n```\n\nThe second query is indented as if it were part of the first query's condition, and its own where-clause is no longer broken out. With `reindent_aligned=True` the same input keeps the keyword and the second select on the line of the first condition:\n\n```\nselect 1\n  from foo\n where 2 = 3 except select 2\n  from bar\n```\n\nand without any condition before it (`select a from foo except select a from bar`) the aligned output runs the first from-clause, the keyword and the second select together on one line. The parse tree shows the cause of the first half: `sqlparse.parse(sql)[0]` now has a single clause group spanning everything from the first where-clause to the end of the statement, where there used to be one group for the first condition, the keyword as a top-level token, and a second group for the second condition. `union` is not affected: `select a from foo union select a from bar` still formats with the keyword on its own line, also after a where-clause, and the aligned mode still breaks before it.",
  "bug_patch": "diff --git a/sqlparse/filters/aligned_indent.py b/sqlparse/filters/aligned_indent.py\nindex dc60926..d935650 100644\n--- a/sqlparse/filters/aligned_indent.py\n+++ b/sqlparse/filters/aligned_indent.py\n@@ -19,7 +19,7 @@ class AlignedIndentFilter:\n                    'WHERE', 'AND', 'OR',\n                    'HAVING', 'LIMIT',\n                    'UNION', 'VALUES',\n-                   'SET', 'BETWEEN', 'EXCEPT')\n+                   'SET', 'BETWEEN')\n \n     def __init__(self, char=' ', n='\\n'):\n         self.n = n\ndiff --git a/sqlparse/filters/reindent.py b/sqlparse/filters/reindent.py\nindex 7dc2b82..ec57a91 100644\n--- a/sqlparse/filters/reindent.py\n+++ b/sqlparse/filters/reindent.py\n@@ -54,7 +54,7 @@ class ReindentFilter:\n     def _next_token(self, tlist, idx=-1):\n         split_words = ('FROM', 'STRAIGHT_JOIN$', 'JOIN$', 'AND', 'OR',\n                        'GROUP BY', 'ORDER BY', 'UNION', 'VALUES',\n-                       'SET', 'BETWEEN', 'EXCEPT', 'HAVING', 'LIMIT')\n+                       'SET', 'BETWEEN', 'HAVING', 'LIMIT')\n         m_split = T.Keyword, split_words, True\n         tidx, token = tlist.token_next_by(m=m_split, idx=idx)\n \ndiff --git a/sqlparse/sql.py b/sqlparse/sql.py\nindex be74694..088dc39 100644\n--- a/sqlparse/sql.py\n+++ b/sqlparse/sql.py\n@@ -551,7 +551,7 @@ class Where(TokenList):\n     \"\"\"A WHERE clause.\"\"\"\n     M_OPEN = T.Keyword, 'WHERE'\n     M_CLOSE = T.Keyword, (\n-        'ORDER BY', 'GROUP BY', 'LIMIT', 'UNION', 'UNION ALL', 'EXCEPT',\n+        'ORDER BY', 'GROUP BY', 'LIMIT', 'UNION', 'UNION ALL',\n         'HAVING', 'RETURNING', 'INTO')\n \n \n",
  "gold_patch": "diff --git a/sqlparse/filters/aligned_indent.py b/sqlparse/filters/aligned_indent.py\nindex d935650..dc60926 100644\n--- a/sqlparse/filters/aligned_indent.py\n+++ b/sqlparse/filters/aligned_indent.py\n@@ -19,7 +19,7 @@ class AlignedIndentFilter:\n                    'WHERE', 'AND', 'OR',\n                    'HAVING', 'LIMIT',\n                    'UNION', 'VALUES',\n-                   'SET', 'BETWEEN')\n+                   'SET', 'BETWEEN', 'EXCEPT')\n \n     def __init__(self, char=' ', n='\\n'):\n         self.n = n\ndiff --git a/sqlparse/filters/reindent.py b/sqlparse/filters/reindent.py\nindex ec57a91..7dc2b82 100644\n--- a/sqlparse/filters/reindent.py\n+++ b/sqlparse/filters/reindent.py\n@@ -54,7 +54,7 @@ class ReindentFilter:\n     def _next_token(self, tlist, idx=-1):\n         split_words = ('FROM', 'STRAIGHT_JOIN$', 'JOIN$', 'AND', 'OR',\n                        'GROUP BY', 'ORDER BY', 'UNION', 'VALUES',\n-                       'SET', 'BETWEEN', 'HAVING', 'LIMIT')\n+                       'SET', 'BETWEEN', 'EXCEPT', 'HAVING', 'LIMIT')\n         m_split = T.Keyword, split_words, True\n         tidx, token = tlist.token_next_by(m=m_split, idx=idx)\n \ndiff --git a/sqlparse/sql.py b/sqlparse/sql.py\nindex 088dc39..be74694 100644\n--- a/sqlparse/sql.py\n+++ b/sqlparse/sql.py\n@@ -551,7 +551,7 @@ class Where(TokenList):\n     \"\"\"A WHERE clause.\"\"\"\n     M_OPEN = T.Keyword, 'WHERE'\n     M_CLOSE = T.Keyword, (\n-        'ORDER BY', 'GROUP BY', 'LIMIT', 'UNION', 'UNION ALL',\n+        'ORDER BY', 'GROUP BY', 'LIMIT', 'UNION', 'UNION ALL', 'EXCEPT',\n         'HAVING', 'RETURNING', 'INTO')\n \n \n",
  "hidden_test_patch": "diff --git a/tests/test_repopilot_sqlparse_001.py b/tests/test_repopilot_sqlparse_001.py\nnew file mode 100644\nindex 0000000..a4e226e\n--- /dev/null\n+++ b/tests/test_repopilot_sqlparse_001.py\n@@ -0,0 +1,44 @@\n+import sqlparse\n+from sqlparse import sql\n+\n+\n+def test_except_ends_the_where_clause():\n+    stmt = sqlparse.parse(\"select 1 from foo where 2 = 3 except select 2 from bar\")[0]\n+    where = [t for t in stmt.tokens if isinstance(t, sql.Where)]\n+    assert [str(w).strip() for w in where] == [\"where 2 = 3\"]\n+    top_level = [str(t) for t in stmt.tokens if not t.is_whitespace]\n+    assert \"except\" in top_level\n+\n+\n+def test_except_ends_a_where_clause_with_a_trailing_condition():\n+    stmt = sqlparse.parse(\"select a from foo where x in (1, 2) except select a from bar where y = 1\")[0]\n+    where = [t for t in stmt.tokens if isinstance(t, sql.Where)]\n+    assert [str(w).strip() for w in where] == [\"where x in (1, 2)\", \"where y = 1\"]\n+\n+\n+def test_reindent_breaks_before_except():\n+    formatted = sqlparse.format(\n+        \"select 1 from foo where 2 = 3 except select 2 from bar where 1 = 2\", reindent=True\n+    )\n+    assert formatted == \"\\n\".join(\n+        [\"select 1\", \"from foo\", \"where 2 = 3\", \"except\", \"select 2\", \"from bar\", \"where 1 = 2\"]\n+    )\n+\n+\n+def test_reindent_breaks_before_except_without_where():\n+    formatted = sqlparse.format(\"select a from foo except select a from bar\", reindent=True)\n+    assert formatted == \"select a\\nfrom foo\\nexcept\\nselect a\\nfrom bar\"\n+\n+\n+def test_aligned_reindent_breaks_before_except():\n+    formatted = sqlparse.format(\n+        \"select 1 from foo where 2 = 3 except select 2 from bar\", reindent_aligned=True\n+    )\n+    assert formatted == \"\\n\".join(\n+        [\"select 1\", \"  from foo\", \" where 2 = 3\", \"except select 2\", \"  from bar\"]\n+    )\n+\n+\n+def test_aligned_reindent_breaks_before_except_without_where():\n+    formatted = sqlparse.format(\"select a from foo except select a from bar\", reindent_aligned=True)\n+    assert formatted == \"select a\\n  from foo\\nexcept select a\\n  from bar\"\n",
  "fail_to_pass": [
    "tests/test_regressions.py::test_except_formatting",
    "tests/test_repopilot_sqlparse_001.py::test_aligned_reindent_breaks_before_except",
    "tests/test_repopilot_sqlparse_001.py::test_aligned_reindent_breaks_before_except_without_where",
