{
  "id": "jinja_004",
  "repo": "https://github.com/pallets/jinja",
  "base_commit": "15206881c006c79667fe5154fe80c01c65410679",
  "source": "mutation",
  "description": "A call that puts a positional argument after a keyword argument is accepted, and the arguments come out in the wrong order.\n\n```python\nfrom jinja2 import Environment\n\nenv = Environment()\ntmpl = env.from_string(\n    \"{% macro pair(a, b) %}{{ a }}-{{ b }}{% endmacro %}{{ pair(b=1, 2) }}\"\n)\nprint(tmpl.render())\n```\n\nThis prints `2-1`. `from_string` used to reject the template:\n\n```\njinja2.exceptions.TemplateSyntaxError: invalid syntax for function call expression\n```\n\nwhich is what `{{ f(*rest, 1) }}` and `{{ f(**extra, 1) }}` still get. Now `{{ pair(b=1, 2) }}` compiles, the `2` is quietly passed as the first positional argument, and the same happens for calls to Python callables (`{{ f(a=1, 2) }}` calls `f(2, a=1)`), and for filters (`{{ 'x'|replace(new='y', 'x') }}`). Calls whose keyword arguments come last (`{{ f(1, 2, a=3) }}`, `{{ f(*rest, a=4) }}`, `{{ f(a=1,) }}`) are fine and must stay accepted.",
  "bug_patch": "diff --git a/src/jinja2/parser.py b/src/jinja2/parser.py\nindex f411775..17c2f51 100644\n--- a/src/jinja2/parser.py\n+++ b/src/jinja2/parser.py\n@@ -917,7 +917,7 @@ class Parser:\n                     kwargs.append(nodes.Keyword(key, value, lineno=value.lineno))\n                 else:\n                     # Parsing an arg\n-                    ensure(dyn_args is None and dyn_kwargs is None and not kwargs)\n+                    ensure(dyn_args is None and dyn_kwargs is None)\n                     args.append(self.parse_expression())\n \n             require_comma = True\n",
  "gold_patch": "diff --git a/src/jinja2/parser.py b/src/jinja2/parser.py\nindex 17c2f51..f411775 100644\n--- a/src/jinja2/parser.py\n+++ b/src/jinja2/parser.py\n@@ -917,7 +917,7 @@ class Parser:\n                     kwargs.append(nodes.Keyword(key, value, lineno=value.lineno))\n                 else:\n                     # Parsing an arg\n-                    ensure(dyn_args is None and dyn_kwargs is None)\n+                    ensure(dyn_args is None and dyn_kwargs is None and not kwargs)\n                     args.append(self.parse_expression())\n \n             require_comma = True\n",
  "hidden_test_patch": "diff --git a/tests/test_repopilot_jinja_004.py b/tests/test_repopilot_jinja_004.py\nnew file mode 100644\nindex 0000000..9fccb32\n--- /dev/null\n+++ b/tests/test_repopilot_jinja_004.py\n@@ -0,0 +1,37 @@\n+import pytest\n+\n+from jinja2 import Environment\n+from jinja2.exceptions import TemplateSyntaxError\n+\n+\n+def record(*args, **kwargs):\n+    return f\"{args} {sorted(kwargs.items())}\"\n+\n+\n+@pytest.mark.parametrize(\n+    \"source\",\n+    [\n+        \"{{ f(a=1, 2) }}\",\n+        \"{{ f(1, b=2, 3) }}\",\n+        \"{{ f(a=1, b=2, 3, 4) }}\",\n+        \"{{ 'x'|replace(new='y', 'x') }}\",\n+        \"{% macro m(a, b) %}{{ a }}-{{ b }}{% endmacro %}{{ m(b=1, 2) }}\",\n+        \"{% call(x) f(a=1, 2) %}{% endcall %}\",\n+    ],\n+)\n+def test_positional_argument_after_keyword_argument_is_a_syntax_error(source):\n+    with pytest.raises(TemplateSyntaxError, match=\"invalid syntax for function call\"):\n+        Environment().from_string(source)\n+\n+\n+def test_valid_argument_orders_still_work():\n+    env = Environment()\n+\n+    with pytest.raises(TemplateSyntaxError):\n+        env.from_string(\"{{ f(a=1, 2) }}\")\n+\n+    tmpl = env.from_string(\"{{ f(1, 2, a=3) }}|{{ f(*items, a=4) }}|{{ f(1, **extra) }}\")\n+    assert tmpl.render(f=record, items=[5], extra={\"b\": 6}) == (\n+        \"(1, 2) [('a', 3)]|(5,) [('a', 4)]|(1,) [('b', 6)]\"\n+    )\n+    assert env.from_string(\"{{ f(a=1,) }}\").render(f=record) == \"() [('a', 1)]\"\n",
  "fail_to_pass": [
