  "source": "mutation",
  "description": "`--help` and `--version` no longer take precedence over an invalid option that appears before them on the command line.\n\n```python\nimport click\n\n@click.command()\n@click.version_option(\"1.2.3\", prog_name=\"tool\")\n@click.option(\"--count\", type=int, default=1)\n@click.option(\"--name\", required=True)\ndef cli(count, name):\n    print(name * count)\n```\n\n```\n$ cli --count x --help\nUsage: cli [OPTIONS]\nTry 'cli --help' for help.\n\nError: Invalid value for '--count': 'x' is not a valid integer.\n$ cli --help --count x\nUsage: cli [OPTIONS]\n\nOptions:\n  --version        Show the version and exit.\n  ...\n$ cli --count x --version\nError: Invalid value for '--count': 'x' is not a valid integer.\n```\n\nBoth orders used to print the help (and the version), because the options that must act first are processed before the others regardless of where they appear. Now they only do so when they come first: whatever precedes them is processed first, in command-line order. The same shows in callbacks: an option declared with `is_eager=True` has its callback run after the callbacks of the options that were typed before it, instead of before all of them.",
  "bug_patch": "diff --git a/src/click/core.py b/src/click/core.py\nindex ff2f74a..46ae7a8 100644\n--- a/src/click/core.py\n+++ b/src/click/core.py\n@@ -135,7 +135,7 @@ def iter_params_for_processing(\n         except ValueError:\n             idx = float(\"inf\")\n \n-        return not item.is_eager, idx\n+        return idx, not item.is_eager\n \n     return sorted(declaration_order, key=sort_key)\n \n",
  "gold_patch": "diff --git a/src/click/core.py b/src/click/core.py\nindex 46ae7a8..ff2f74a 100644\n--- a/src/click/core.py\n+++ b/src/click/core.py\n@@ -135,7 +135,7 @@ def iter_params_for_processing(\n         except ValueError:\n             idx = float(\"inf\")\n \n-        return idx, not item.is_eager\n+        return not item.is_eager, idx\n \n     return sorted(declaration_order, key=sort_key)\n \n",
  "hidden_test_patch": "diff --git a/tests/test_repopilot_click_007.py b/tests/test_repopilot_click_007.py\nnew file mode 100644\nindex 0000000..0ac9ea0\n--- /dev/null\n+++ b/tests/test_repopilot_click_007.py\n@@ -0,0 +1,46 @@\n+import click\n+from click.testing import CliRunner\n+\n+\n+def _cli():\n+    @click.command()\n+    @click.version_option(\"1.2.3\", prog_name=\"tool\")\n+    @click.option(\"--count\", type=int, default=1)\n+    @click.option(\"--name\", required=True)\n+    def cli(count, name):\n+        click.echo(name * count)\n+\n+    return cli\n+\n+\n+def test_help_and_version_win_over_an_invalid_option_given_before_them():\n+    runner = CliRunner()\n+    for args in ([\"--count\", \"x\", \"--help\"], [\"--name\", \"a\", \"--count\", \"x\", \"--help\"]):\n+        result = runner.invoke(_cli(), args)\n+        assert result.exit_code == 0, (args, result.output)\n+        assert result.output.startswith(\"Usage: cli [OPTIONS]\"), (args, result.output)\n+        assert \"is not a valid integer\" not in result.output\n+\n+    result = runner.invoke(_cli(), [\"--count\", \"x\", \"--version\"])\n+    assert result.exit_code == 0, result.output\n+    assert result.output == \"tool, version 1.2.3\\n\"\n+\n+\n+def test_eager_callbacks_run_before_the_others_whatever_the_command_line_order():\n+    order = []\n+\n+    def record(ctx, param, value):\n+        order.append(param.name)\n+        return value\n+\n+    @click.command()\n+    @click.option(\"--normal-a\", is_flag=True, callback=record)\n+    @click.option(\"--eager\", is_flag=True, is_eager=True, callback=record)\n+    @click.option(\"--normal-b\", is_flag=True, callback=record)\n+    def cli(normal_a, eager, normal_b):\n+        pass\n+\n+    runner = CliRunner()\n+    result = runner.invoke(cli, [\"--normal-b\", \"--normal-a\", \"--eager\"])\n+    assert result.exit_code == 0, result.output\n+    assert order == [\"eager\", \"normal_b\", \"normal_a\"]\n",
