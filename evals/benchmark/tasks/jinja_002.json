  "source": "mutation",
  "description": "Loading a template now fails when a custom filter applied to literal arguments raises, even if the filter sits in a branch that never renders.\n\n```python\nfrom jinja2 import Environment\n\n\nclass LookupFailed(Exception):\n    pass\n\n\ndef lookup(key):\n    raise LookupFailed(f\"no entry for {key!r}\")\n\n\nenv = Environment()\nenv.filters[\"lookup\"] = lookup\nenv.from_string(\"{% if false %}{{ 'x'|lookup }}{% endif %}ok\")\n```\n\nThis raises `LookupFailed: no entry for 'x'` from `from_string` — before, the template loaded and rendered `ok`, and the filter only ran (and only raised) when its branch actually rendered. The same template with a variable instead of the literal (`{{ key|lookup }}`) still loads fine. A custom test used on a literal shows it too: `{% if false %}{{ 'b' is registered }}{% endif %}` with a `registered` test that raises `KeyError` for unknown names now fails at load time with that `KeyError`, and a filter that raises `StopIteration` on `{{ {}|first_key }}` fails the same way. Built-in filters given the wrong kind of literal argument (`{{ 'abc'|center('w') }}` inside a dead branch) still load and render as before.\n\nRendering `{{ 'x'|lookup }}` in a live branch should still raise `LookupFailed` — but from `render`, not from loading the template.",
  "bug_patch": "diff --git a/src/jinja2/nodes.py b/src/jinja2/nodes.py\nindex 2f93b90..5fdc57b 100644\n--- a/src/jinja2/nodes.py\n+++ b/src/jinja2/nodes.py\n@@ -780,7 +780,7 @@ class _FilterTestCommon(Expr):\n \n         try:\n             return func(*args, **kwargs)\n-        except Exception as e:\n+        except (TypeError, ValueError) as e:\n             raise Impossible() from e\n \n \n",
  "gold_patch": "diff --git a/src/jinja2/nodes.py b/src/jinja2/nodes.py\nindex 5fdc57b..2f93b90 100644\n--- a/src/jinja2/nodes.py\n+++ b/src/jinja2/nodes.py\n@@ -780,7 +780,7 @@ class _FilterTestCommon(Expr):\n \n         try:\n             return func(*args, **kwargs)\n-        except (TypeError, ValueError) as e:\n+        except Exception as e:\n             raise Impossible() from e\n \n \n",
  "hidden_test_patch": "diff --git a/tests/test_repopilot_jinja_002.py b/tests/test_repopilot_jinja_002.py\nnew file mode 100644\nindex 0000000..adac36c\n--- /dev/null\n+++ b/tests/test_repopilot_jinja_002.py\n@@ -0,0 +1,58 @@\n+import pytest\n+\n+from jinja2 import DictLoader\n+from jinja2 import Environment\n+\n+\n+class LookupError_(Exception):\n+    pass\n+\n+\n+def make_env():\n+    env = Environment(loader=DictLoader({\"page\": \"{% if false %}{{ 'x'|lookup }}{% endif %}ok\"}))\n+\n+    def lookup(value):\n+        raise LookupError_(f\"no entry for {value!r}\")\n+\n+    env.filters[\"lookup\"] = lookup\n+    env.filters[\"first_key\"] = lambda mapping: next(iter(mapping))\n+    env.tests[\"registered\"] = lambda name: {\"a\": 1}[name] == 1\n+    return env\n+\n+\n+def test_filter_error_in_dead_branch_does_not_break_loading():\n+    env = make_env()\n+    tmpl = env.from_string(\"{% if false %}{{ 'x'|lookup }}{% endif %}ok\")\n+    assert tmpl.render() == \"ok\"\n+    assert env.get_template(\"page\").render() == \"ok\"\n+    # argument errors from constant folding stay deferred as before\n+    assert env.from_string(\"{% if false %}{{ 'abc'|center('w') }}{% endif %}ok\").render() == \"ok\"\n+\n+\n+def test_filter_error_is_raised_when_the_branch_renders():\n+    env = make_env()\n+    tmpl = env.from_string(\"{% if flag %}{{ 'x'|lookup }}{% else %}no{% endif %}\")\n+    assert tmpl.render(flag=False) == \"no\"\n+\n+    with pytest.raises(LookupError_):\n+        tmpl.render(flag=True)\n+\n+\n+def test_filter_error_is_raised_at_render_time_not_compile_time():\n+    env = make_env()\n+    tmpl = env.from_string(\"{{ 'x'|lookup }}\")\n+\n+    with pytest.raises(LookupError_):\n+        tmpl.render()\n+\n+\n+@pytest.mark.parametrize(\n+    \"source\",\n+    [\n+        \"{% if false %}{{ {}|first_key }}{% endif %}ok\",\n+        \"{% if false %}{{ 'b' is registered }}{% endif %}ok\",\n+    ],\n+)\n+def test_other_error_types_from_constant_arguments(source):\n+    env = make_env()\n+    assert env.from_string(source).render() == \"ok\"\n",
  "fail_to_pass": [
