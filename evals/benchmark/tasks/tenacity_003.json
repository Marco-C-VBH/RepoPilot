{
  "id": "tenacity_003",
  "repo": "https://github.com/jd/tenacity",
  "base_commit": "a2af454834c6bb5a1e39d67334031cdaf0f475b5",
  "source": "mutation",
  "description": "`retry_if_exception_type` no longer matches subclasses of the configured exception types.\n\n`@retry(retry=retry_if_exception_type(OSError), stop=stop_after_attempt(3), wait=wait_none(), reraise=True)` gives up after the first `FileNotFoundError` instead of retrying, while raising `OSError` itself is retried as expected. The same happens with user-defined hierarchies and with tuples of types: `retry_if_exception_type((KeyError, OSError))` does not retry on `PermissionError`. Because the default retry policy is supposed to retry on any `Exception`, many decorated functions now fail on their first error unless it is a bare `Exception`.\n\nInstances of subclasses must be treated like instances of the configured types.",
  "bug_patch": "diff --git a/tenacity/retry.py b/tenacity/retry.py\nindex 61c63d2..e035200 100644\n--- a/tenacity/retry.py\n+++ b/tenacity/retry.py\n@@ -111,7 +111,10 @@ class retry_if_exception_type(retry_if_exception):\n         super().__init__(self._check)\n \n     def _check(self, e: BaseException) -> bool:\n-        return isinstance(e, self.exception_types)\n+        types = self.exception_types\n+        if not isinstance(types, tuple):\n+            types = (types,)\n+        return type(e) in types\n \n \n class retry_if_not_exception_type(retry_if_exception):\n",
  "gold_patch": "diff --git a/tenacity/retry.py b/tenacity/retry.py\nindex e035200..61c63d2 100644\n--- a/tenacity/retry.py\n+++ b/tenacity/retry.py\n@@ -111,10 +111,7 @@ class retry_if_exception_type(retry_if_exception):\n         super().__init__(self._check)\n \n     def _check(self, e: BaseException) -> bool:\n-        types = self.exception_types\n-        if not isinstance(types, tuple):\n-            types = (types,)\n-        return type(e) in types\n+        return isinstance(e, self.exception_types)\n \n \n class retry_if_not_exception_type(retry_if_exception):\n",
  "hidden_test_patch": "diff --git a/tests/test_repopilot_tenacity_003.py b/tests/test_repopilot_tenacity_003.py\nnew file mode 100644\nindex 0000000..658c34e\n--- /dev/null\n+++ b/tests/test_repopilot_tenacity_003.py\n@@ -0,0 +1,41 @@\n+import tenacity\n+\n+\n+class TransientError(Exception):\n+    pass\n+\n+\n+class Timeout(TransientError):\n+    pass\n+\n+\n+def attempts_until_giving_up(exc_type, policy):\n+    calls = []\n+\n+    @tenacity.retry(\n+        retry=policy, stop=tenacity.stop_after_attempt(3), wait=tenacity.wait_none(), reraise=True\n+    )\n+    def failing():\n+        calls.append(1)\n+        raise exc_type(\"boom\")\n+\n+    try:\n+        failing()\n+    except BaseException:\n+        pass\n+    return len(calls)\n+\n+\n+def test_subclasses_of_a_retried_exception_type_are_retried():\n+    policy = tenacity.retry_if_exception_type(TransientError)\n+    assert attempts_until_giving_up(Timeout, policy) == 3\n+    assert attempts_until_giving_up(TransientError, policy) == 3\n+    assert attempts_until_giving_up(ValueError, policy) == 1\n+\n+\n+def test_builtin_hierarchy_and_tuples():\n+    assert attempts_until_giving_up(FileNotFoundError, tenacity.retry_if_exception_type(OSError)) == 3\n+    policy = tenacity.retry_if_exception_type((KeyError, OSError))\n+    assert attempts_until_giving_up(PermissionError, policy) == 3\n+    assert attempts_until_giving_up(KeyError, policy) == 3\n+    assert attempts_until_giving_up(IndexError, policy) == 1\n",
  "fail_to_pass": [
