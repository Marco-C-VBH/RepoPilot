  "base_commit": "2dca1b70359dac61e1bbfb6f14ebe19a5ab79c3d",
  "source": "mutation",
  "description": "A closing markup tag is only accepted when it repeats the opening tag word for word: a different word order or a different case is reported as a tag that was never opened.\n\n```python\nfrom rich.console import Console\n\nconsole = Console()\nconsole.print(\"[bold red]alert[/red bold] done\")\n```\n\n```\nTraceback (most recent call last):\n  ...\nrich.errors.MarkupError: closing tag '[/red bold]' at position 15 doesn't match any open tag\n```\n\n`[bold red]alert[/bold red] done` prints fine, and so does the shorthand `[/]`. The same error comes from `[bold]shout[/Bold]`, `[bold]a[/BOLD]`, `[red on blue]x[/on blue red]` and `[not bold italic]a[/italic not bold]`, although each closing tag names exactly the style that is open; `Text.from_markup` raises the same way. Only spellings that differ from the opening tag are affected, and a closing tag for a style that really is not open (`[bold]a[/red]`) is still, correctly, an error.",
  "bug_patch": "diff --git a/rich/markup.py b/rich/markup.py\nindex bd9c05a..e4328aa 100644\n--- a/rich/markup.py\n+++ b/rich/markup.py\n@@ -160,7 +160,6 @@ def render(\n                 style_name = tag.name[1:].strip()\n \n                 if style_name:  # explicit close\n-                    style_name = normalize(style_name)\n                     try:\n                         start, open_tag = pop_style(style_name)\n                     except KeyError:\n",
  "gold_patch": "diff --git a/rich/markup.py b/rich/markup.py\nindex e4328aa..bd9c05a 100644\n--- a/rich/markup.py\n+++ b/rich/markup.py\n@@ -160,6 +160,7 @@ def render(\n                 style_name = tag.name[1:].strip()\n \n                 if style_name:  # explicit close\n+                    style_name = normalize(style_name)\n                     try:\n                         start, open_tag = pop_style(style_name)\n                     except KeyError:\n",
  "hidden_test_patch": "diff --git a/tests/test_repopilot_rich_004.py b/tests/test_repopilot_rich_004.py\nnew file mode 100644\nindex 0000000..8a87fc2\n--- /dev/null\n+++ b/tests/test_repopilot_rich_004.py\n@@ -0,0 +1,38 @@\n+import io\n+\n+import pytest\n+\n+from rich.console import Console\n+from rich.text import Span, Text\n+\n+\n+def _print(markup: str) -> str:\n+    console = Console(\n+        file=io.StringIO(),\n+        width=60,\n+        force_terminal=False,\n+        color_system=None,\n+        legacy_windows=False,\n+    )\n+    console.print(markup)\n+    return console.file.getvalue()\n+\n+\n+@pytest.mark.parametrize(\n+    (\"markup\", \"expected\"),\n+    [\n+        (\"[bold red]alert[/red bold] done\", \"alert done\\n\"),\n+        (\"[bold]shout[/Bold]\", \"shout\\n\"),\n+        (\"[bold]a[/BOLD]\", \"a\\n\"),\n+        (\"[red on blue]x[/on blue red] y\", \"x y\\n\"),\n+        (\"[not bold italic]a[/italic not bold]\", \"a\\n\"),\n+    ],\n+)\n+def test_closing_tags_match_regardless_of_word_order_and_case(markup, expected):\n+    assert _print(markup) == expected\n+\n+\n+def test_spans_are_the_same_whichever_spelling_closes_the_tag():\n+    reordered = Text.from_markup(\"[bold red]alert[/red bold] done\")\n+    canonical = Text.from_markup(\"[bold red]alert[/bold red] done\")\n+    assert reordered.spans == canonical.spans == [Span(0, 5, \"bold red\")]\n",
  "fail_to_pass": [
