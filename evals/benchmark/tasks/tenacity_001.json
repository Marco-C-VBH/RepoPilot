  "base_commit": "a2af454834c6bb5a1e39d67334031cdaf0f475b5",
  "source": "mutation",
  "description": "`stop_after_attempt(n)` allows one attempt too many.\n\nA function decorated with `@retry(stop=stop_after_attempt(3), wait=wait_none(), reraise=True)` that always raises is called four times before the exception is re-raised; the documented behaviour is three attempts in total. The stop predicate itself returns `False` when `attempt_number` equals the limit. Existing tests such as `test_stop_after_attempt`, `test_stop_any` and `test_stop_all` in `tests/test_tenacity.py` fail.\n\nThe fix belongs in the `stop_after_attempt` strategy in `tenacity/stop.py`: the limit must be inclusive.",
  "bug_patch": "diff --git a/tenacity/stop.py b/tenacity/stop.py\nindex c2251b3..c4273b1 100644\n--- a/tenacity/stop.py\n+++ b/tenacity/stop.py\n@@ -88,7 +88,7 @@ class stop_after_attempt(stop_base):\n         self.max_attempt_number = max_attempt_number\n \n     def __call__(self, retry_state: \"RetryCallState\") -> bool:\n-        return retry_state.attempt_number >= self.max_attempt_number\n+        return retry_state.attempt_number > self.max_attempt_number\n \n \n class stop_after_delay(stop_base):\n",
  "gold_patch": "diff --git a/tenacity/stop.py b/tenacity/stop.py\nindex c4273b1..c2251b3 100644\n--- a/tenacity/stop.py\n+++ b/tenacity/stop.py\n@@ -88,7 +88,7 @@ class stop_after_attempt(stop_base):\n         self.max_attempt_number = max_attempt_number\n \n     def __call__(self, retry_state: \"RetryCallState\") -> bool:\n-        return retry_state.attempt_number > self.max_attempt_number\n+        return retry_state.attempt_number >= self.max_attempt_number\n \n \n class stop_after_delay(stop_base):\n",
  "hidden_test_patch": "diff --git a/tests/test_repopilot_tenacity_001.py b/tests/test_repopilot_tenacity_001.py\nnew file mode 100644\nindex 0000000..79c7402\n--- /dev/null\n+++ b/tests/test_repopilot_tenacity_001.py\n@@ -0,0 +1,31 @@\n+import tenacity\n+from tenacity import Retrying, RetryCallState\n+\n+\n+def state_for_attempt(attempt_number):\n+    state = RetryCallState(None, None, (), {})\n+    state.attempt_number = attempt_number\n+    state.set_result(None)\n+    return state\n+\n+\n+def test_stop_after_attempt_limits_the_total_number_of_calls():\n+    calls = []\n+\n+    @tenacity.retry(stop=tenacity.stop_after_attempt(3), wait=tenacity.wait_none(), reraise=True)\n+    def flaky():\n+        calls.append(len(calls) + 1)\n+        raise ValueError(\"still failing\")\n+\n+    try:\n+        flaky()\n+    except ValueError:\n+        pass\n+    assert calls == [1, 2, 3]\n+\n+\n+def test_stop_after_attempt_is_true_at_the_limit():\n+    r = Retrying(stop=tenacity.stop_after_attempt(2))\n+    assert r.stop(state_for_attempt(1)) is False\n+    assert r.stop(state_for_attempt(2)) is True\n+    assert r.stop(state_for_attempt(5)) is True\n",
  "fail_to_pass": [
