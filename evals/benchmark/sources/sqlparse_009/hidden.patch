+import pytest
+
+import sqlparse
+from sqlparse import sql
+
+
+@pytest.mark.parametrize(
+    's', ["x > DATE '2020-01-01'", "x > TIMESTAMP '2020-01-01 00:00:00'"]
+)
+def test_grouping_typed_literal(s):
+    parsed = sqlparse.parse(s)[0]
+    assert isinstance(parsed[4], sql.TypedLiteral)
+
+
+def test_timestamp_literal_in_an_operation():
+    parsed = sqlparse.parse("select timestamp '2020-01-01' + interval '1 day' from t")[0]
+    tokens = [t for t in parsed.tokens if not t.is_whitespace]
+    assert isinstance(tokens[1], sql.Operation)
+    assert str(tokens[1]) == "timestamp '2020-01-01' + interval '1 day'"
+    literal = tokens[1].tokens[0]
+    assert isinstance(literal, sql.TypedLiteral)
+    assert str(literal) == "timestamp '2020-01-01'"
