+import tenacity
+from tenacity import Retrying, RetryCallState
+
+
+def state_for_attempt(attempt_number):
+    state = RetryCallState(None, None, (), {})
+    state.attempt_number = attempt_number
+    state.set_result(None)
+    return state
+
+
+def test_first_wait_equals_the_multiplier():
+    r = Retrying(wait=tenacity.wait_exponential(multiplier=1, max=100))
+    assert [r.wait(state_for_attempt(n)) for n in (1, 2, 3, 4)] == [1, 2, 4, 8]
+
+
+def test_custom_multiplier_and_base():
+    r = Retrying(wait=tenacity.wait_exponential(multiplier=0.5, exp_base=3, max=1000))
+    assert [r.wait(state_for_attempt(n)) for n in (1, 2, 3, 4)] == [0.5, 1.5, 4.5, 13.5]
