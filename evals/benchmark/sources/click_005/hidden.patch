+import click
+from click.testing import CliRunner
+
+
+def _help_lines(cli):
+    result = CliRunner().invoke(cli, ["--help"])
+    assert result.exit_code == 0, result.output
+    return result.output.splitlines()
+
+
+def test_option_help_never_runs_past_the_terminal_width():
+    overlong = []
+    for width in (60, 80, 100):
+        for word_len in range(1, 9):
+            text = " ".join(["x" * word_len] * 60)
+
+            @click.command(context_settings={"terminal_width": width})
+            @click.option("--name", help=text)
+            @click.option("--a-considerably-longer-option-name", help=text)
+            def cli(name, a_considerably_longer_option_name):
+                pass
+
+            for line in _help_lines(cli):
+                if len(line) > width:
+                    overlong.append((width, word_len, len(line), line))
+    assert not overlong, overlong
+
+
+def test_exact_wrapping_of_option_help():
+    @click.command(context_settings={"terminal_width": 80})
+    @click.option("--name", help=" ".join(["wordy"] * 16))
+    @click.option("--a-considerably-longer-option-name", help="short")
+    def cli(name, a_considerably_longer_option_name):
+        pass
+
+    lines = _help_lines(cli)
+    assert lines[3:6] == [
+        "  --name TEXT                     wordy wordy wordy wordy wordy wordy wordy",
+        "                                  wordy wordy wordy wordy wordy wordy wordy",
+        "                                  wordy wordy",
+    ], lines
